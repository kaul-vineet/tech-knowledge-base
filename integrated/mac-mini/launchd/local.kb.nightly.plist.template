<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- User LaunchAgent for the nightly L600 run. Fill __KB_ROOT__, __HOME__ and __PATH__ (see integrated/mac-mini/README.md),
     save as ~/Library/LaunchAgents/local.kb.nightly.plist, check with plutil -lint, then launchctl bootstrap.
     caffeinate -i keeps the Mac from idle-sleeping while the run is in progress. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.kb.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/bash</string>
    <string>__KB_ROOT__/integrated/mac-mini/scripts/nightly.sh</string>
    <string>--with-tests</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>KB_RUNS_DIR</key>
    <string>__HOME__/kb-runs</string>
    <key>KB_KEEP_DAYS</key>
    <string>30</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__KB_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/kb-runs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/kb-runs/launchd.err.log</string>
</dict>
</plist>
