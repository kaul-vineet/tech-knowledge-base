{
  "_comment": "Service manifest: owner, what the data is, x = secrecy years (how long it must stay confidential), y = migration years (team estimate). Paths are relative to the lab folder.",
  "services": {
    "payments":  {"owner": "payments-team",  "data": "archived card tokens",            "secrecy_years": 10, "migration_years": 3,
                  "paths": ["sample_repo/services/payments", "sample_repo/config/payments"]},
    "records":   {"owner": "records-team",   "data": "customer records in replication", "secrecy_years": 7,  "migration_years": 3,
                  "paths": ["sample_repo/services/records"]},
    "auth":      {"owner": "identity-team",  "data": "15-minute session tokens",        "secrecy_years": 0,  "migration_years": 2,
                  "paths": ["sample_repo/services/auth", "sample_repo/config/auth"]},
    "messaging": {"owner": "messaging-team", "data": "patient messages",                "secrecy_years": 12, "migration_years": 2,
                  "paths": ["sample_repo/services/messaging", "migrated/messaging", "faults/messaging_bypass", "faults/messaging_downgrade"]},
    "edge":      {"owner": "platform-team",  "data": "public web traffic",              "secrecy_years": 5,  "migration_years": 2,
                  "paths": ["sample_repo/config/edge"]},
    "reports":   {"owner": "analytics-team", "data": "report exports at rest",          "secrecy_years": 10, "migration_years": 1,
                  "paths": ["sample_repo/services/reports"]}
  }
}
