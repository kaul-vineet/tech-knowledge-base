{
  "consumer": "dashboard-v1",
  "interactions": [
    {
      "description": "latest reading, v1",
      "providerState": "d01 has readings",
      "request": {
        "method": "GET",
        "path": "/v1/devices/d01/latest"
      },
      "response": {
        "body": {
          "device": "d01",
          "seq": 1,
          "tempC": 20
        },
        "matchingRules": {
          "$.seq": "type",
          "$.tempC": "type"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "consumerVersion": "1.4.0",
    "format": "lesson-14 contract v1"
  },
  "provider": "fleet-api"
}
