flowchart LR
  subgraph AST[astronomy]
    IN["inputs.rows()<br/>L400 #21 (synthetic Gaia-like,<br/>real CC BY-NC 3.0 IGO credit)"] --> PROC["science.process()<br/>parallax/error >= 5 ? 1/parallax : needs-prior<br/>L100 #4 units"]
    LIC["licence gate<br/>L400 #21 release_licence()<br/>keeps NC -> CC-BY-NC-4.0"]
