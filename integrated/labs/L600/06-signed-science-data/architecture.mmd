  subgraph CRY[cryptography]
    PROC -->|"JCS bytes (RFC 8785)"| FILES["5 files<br/>catalogue.json, LICENSE.txt,<br/>ACKNOWLEDGEMENTS.md, CITATION.cff,<br/>provenance.json"]
    LIC --> FILES
    FILES --> MAN["manifest: sha256 + length per file,<br/>Merkle root (RFC 9162)"]
    MAN --> SIG["release.json<br/>Ed25519 + ML-DSA-65<br/>(L400 #17 registry, transition phase)"]
    ROOT["root.json v1 -> v2<br/>rotation keeps retired keys<br/>valid_through_version"] -.trusts.-> SIG
    SIG --> LOG["transparency log<br/>STH, inclusion + consistency proofs"]
    SIG --> TS["timestamp.json<br/>TTL 3600 s, version"]
  end
  subgraph DS[distributed systems]
    M0[(m0)] <-->|"push-pull gossip<br/>Merkle over 16 buckets"| M1[(m1)]
