// Close sibling of the micro:bit V2 target MCU: Renode's stock nRF52840 model.
// Only change: uart0 in legacy UART mode (no EasyDMA). The stock file sets
// easyDMA: true, and legacy UART firmware then hangs (renode issue #1014);
// Renode's own NRF52840.robot uses the same override for its UART tests.
using "platforms/cpus/nrf52840.repl"

uart0:
    easyDMA: false
