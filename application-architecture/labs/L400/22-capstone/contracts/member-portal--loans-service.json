{
  "consumer": "member-portal",
  "interactions": [
    {
      "description": "a member reads their loans",
      "providerState": "member m1 of lib00 has one loan",
      "request": {
        "method": "GET",
        "path": "/tenants/lib00/members/m1/loans"
      },
      "response": {
        "body": {
          "loans": [
            {
              "bookId": "b1",
              "loanId": 1
            }
          ],
          "memberId": "m1"
        },
        "matchingRules": {
          "$.loans": "type",
          "$.memberId": "type"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "consumerVersion": "2.0.0",
    "format": "lesson-14 contract v1"
  },
  "provider": "loans-service"
}
