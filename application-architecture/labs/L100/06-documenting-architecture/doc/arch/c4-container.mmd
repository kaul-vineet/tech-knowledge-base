C4Container
%% C4 container = an application or data store that must run; NOT a Docker container
  title Container diagram for Library Loans
  Person(member, "Library member", "Borrows and returns books.")
  Person(librarian, "Librarian", "Looks up and closes loans at the desk.")
  System_Ext(email, "E-mail system", "Sends due-date reminders.")
  Container_Boundary(loans, "Library Loans") {
    Container(api, "Loans API", "Python 3.12, http.server", "Layered modular monolith: catalog and loans modules.")
    ContainerDb(db, "Loans database", "SQLite 3", "Stores loans and book status.")
  }
%% relationships: Rel(from, to, label, technology); every id must be defined above
  Rel(member, api, "Borrows and returns books using", "JSON/HTTP")
  Rel(librarian, api, "Looks up loans using", "JSON/HTTP")
  Rel(api, db, "Reads from and writes to", "sqlite3")
  Rel(api, email, "Sends reminders using", "SMTP")
