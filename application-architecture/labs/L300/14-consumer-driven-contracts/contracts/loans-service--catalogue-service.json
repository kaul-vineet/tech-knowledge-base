{
  "consumer": "loans-service",
  "interactions": [
    {
      "description": "a request for an existing book",
      "providerState": "book b1 exists",
      "request": {
        "method": "GET",
        "path": "/books/b1"
      },
      "response": {
        "body": {
          "available": true,
          "id": "b1",
          "title": "Dune"
        },
        "matchingRules": {
          "$.available": "type",
          "$.title": "type"
        },
        "status": 200
      }
    },
    {
      "description": "a request for a missing book",
      "providerState": "no books",
      "request": {
        "method": "GET",
        "path": "/books/b404"
      },
      "response": {
        "body": {},
        "matchingRules": {},
        "status": 404
      }
    }
  ],
  "metadata": {
    "consumerVersion": "1.4.0",
    "format": "lesson-14 contract v1"
  },
  "provider": "catalogue-service"
}
